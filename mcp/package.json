{
  "name": "@dryspell/mcp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Read-only Model Context Protocol server for Dryspell: quote cover, list policies, read vault and trigger status from Arbitrum Sepolia.",
  "bin": {
