# Copy to .env (gitignored). Never commit real keys.
# Arbitrum Sepolia RPC
ARBITRUM_SEPOLIA_RPC=https://sepolia-rollup.arbitrum.io/rpc
# Deployer key for testnet only — fund via a public faucet; never reuse a mainnet key
DEPLOYER_PRIVATE_KEY=
# Free Etherscan V2 API key (works for Arbiscan); needed only to verify contracts
ETHERSCAN_API_KEY=
