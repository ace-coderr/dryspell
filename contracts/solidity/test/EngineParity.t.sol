pragma solidity ^0.8.28;

import {Test} from "forge-std/Test.sol";
import {DryspellEngineSol} from "../src/DryspellEngineSol.sol";

/// @notice Replays vectors generated by the Rust (Stylus) engine against the Solidity fallback.
///         Every quote - successes and every revert reason - must match exactly.
///         Vectors: test/vectors/engine_vectors.json, generated by
///         `DRYSPELL_WRITE_VECTORS=1 cargo test --lib parity_vectors` in contracts/stylus.
contract EngineParityTest is Test {
    DryspellEngineSol engine;
    address constant OWNER = address(0xA11CE);

    function _u32(uint256[] memory a) internal pure returns (uint32[] memory r) {
        r = new uint32[](a.length);
        for (uint256 i; i < a.length; ++i) {
            r[i] = uint32(a[i]);
        }
    }

    function _selector(string memory name) internal pure returns (bytes4) {
        return bytes4(keccak256(bytes(string.concat(name, "()"))));
    }

    function _setParams(string memory json, uint256 p) internal {
        string memory pb = string.concat(".params[", vm.toString(p), "]");
        uint256 k = vm.parseJsonUint(json, string.concat(pb, ".k"));
        uint256 floorPpm = vm.parseJsonUint(json, string.concat(pb, ".floor"));
        uint256 loading = vm.parseJsonUint(json, string.concat(pb, ".loading"));
        uint256 maxRate = vm.parseJsonUint(json, string.concat(pb, ".maxRate"));
        engine.setPricingParams(k, floorPpm, loading, maxRate, 9_000); // utilisation cap is irrelevant to quotes
    }

    struct Cols {
        uint256[] table;
        uint256[] params;
        uint256[] level;
        uint256[] payout;
        bool[] ok;
        uint256[] premium;
        uint256[] p;
        uint256[] se;
        uint256[] rate;
        string[] err;
    }

    function _cols(string memory json) internal view returns (Cols memory c) {
        c.table = vm.parseJsonUintArray(json, ".vectors.table");
        c.params = vm.parseJsonUintArray(json, ".vectors.params");
        c.level = vm.parseJsonUintArray(json, ".vectors.level");
        c.payout = vm.parseJsonUintArray(json, ".vectors.payout");
        c.ok = vm.parseJsonBoolArray(json, ".vectors.ok");
        c.premium = vm.parseJsonUintArray(json, ".vectors.premium");
        c.p = vm.parseJsonUintArray(json, ".vectors.p");
        c.se = vm.parseJsonUintArray(json, ".vectors.se");
        c.rate = vm.parseJsonUintArray(json, ".vectors.rate");
        c.err = vm.parseJsonStringArray(json, ".vectors.err");
    }

    /// @return true if vector i was a success case
    function _check(Cols memory c, uint256 i) internal returns (bool) {
        if (c.ok[i]) {
            (uint256 prem, uint256 pp, uint256 se, uint256 rate) = engine.quote(c.table[i], c.level[i], c.payout[i]);
            assertEq(prem, c.premium[i], "premium");
            assertEq(pp, c.p[i], "p");
            assertEq(se, c.se[i], "se");
            assertEq(rate, c.rate[i], "rate");
            return true;
        }
        try engine.quote(c.table[i], c.level[i], c.payout[i]) returns (uint256, uint256, uint256, uint256) {
            revert(string.concat("expected revert ", c.err[i], " at vector ", vm.toString(i)));
        } catch (bytes memory reason) {
            assertEq(bytes4(reason), _selector(c.err[i]), string.concat("wrong revert at vector ", vm.toString(i)));
        }
        return false;
    }

    function test_parity_with_rust_engine() public {
        string memory json = vm.readFile("test/vectors/engine_vectors.json");
        engine = new DryspellEngineSol(OWNER);
        vm.startPrank(OWNER);

        for (uint256 i; i < 6; ++i) {
            string memory base = string.concat(".tables[", vm.toString(i), "]");
            engine.loadTable(
                i,
                0,
                uint8(vm.parseJsonUint(json, string.concat(base, ".peril"))),
                _u32(vm.parseJsonUintArray(json, string.concat(base, ".levels"))),
                _u32(vm.parseJsonUintArray(json, string.concat(base, ".p"))),
                _u32(vm.parseJsonUintArray(json, string.concat(base, ".se")))
            );
        }

        Cols memory c = _cols(json);
        assertGt(c.table.length, 5000, "expected thousands of vectors");

        uint256 curParams = type(uint256).max;
        uint256 okCount;
        uint256 errCount;
        for (uint256 i; i < c.table.length; ++i) {
            if (c.params[i] != curParams) {
                _setParams(json, c.params[i]);
                curParams = c.params[i];
            }
            if (_check(c, i)) ++okCount;
            else ++errCount;
        }
        // both branches are really exercised
        assertGt(okCount, 1000);
        assertGt(errCount, 1000);
    }
}
